# ==============================================================================
# FloodGuard Environment Configuration
# ==============================================================================

# Server & API Base
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. India Meteorological Department (IMD) Official API
# Portal: https://api.imd.gov.in/public/
# Requires registration on the IMD API portal to obtain API Key and JWT Bearer Token.
# When omitted, FloodGuard serves verified Open-Meteo observations with an honest fallback status.
# ------------------------------------------------------------------------------
IMD_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 2. Central Water Commission (CWC) & NWIC
# Portals: https://ffs.india-water.gov.in/ & https://nwdp.nwic.gov.in/
# ------------------------------------------------------------------------------
CWC_API_URL=https://ffs.india-water.gov.in
NWIC_API_URL=https://nwdp.nwic.gov.in

# ------------------------------------------------------------------------------
# 3. NDMA SACHET — National Disaster Alert Portal (CAP Feed)
# Portal: https://sachet.ndma.gov.in/
# ------------------------------------------------------------------------------
SACHET_BASE_URL=https://sachet.ndma.gov.in

# ------------------------------------------------------------------------------
# 4. Copernicus Data Space Ecosystem (CDSE) / Sentinel-1
# Portal: https://documentation.dataspace.copernicus.eu/APIs/STAC.html
# Configurable catalogue and upcoming STAC migration endpoint.
# ------------------------------------------------------------------------------
COPERNICUS_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
