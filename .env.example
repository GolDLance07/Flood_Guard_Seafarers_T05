# ==============================================================================
# FloodGuard Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' in the project root:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# FloodGuard operates fully out-of-the-box with graceful fallbacks if keys are unset.
# Adding official credentials enables direct government API telemetry.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Host interface and port for the FastAPI server (used by python run.py)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. India Meteorological Department (IMD) Official API
# ------------------------------------------------------------------------------
# Portal: https://api.imd.gov.in/public/
# To obtain credentials:
#   1. Register an account on the IMD API public portal.
#   2. Generate an API Key (sent via header: X-Api-Key).
#   3. Generate a JWT Bearer Token (sent via header: Authorization: Bearer <token>).
#
# Graceful Fallback:
#   If IMD keys are left empty, FloodGuard automatically streams verified real-time
#   meteorological observations from Open-Meteo (ECMWF/GFS models) for Alappuzha
#   and clearly flags the data source as a fallback in the monitoring telemetry.
IMD_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 3. Central Water Commission (CWC) & NWIC River Gauging
# ------------------------------------------------------------------------------
# Portals:
#   - CWC Flood Forecasting:     https://ffs.india-water.gov.in/
#   - National Water Data Portal: https://nwdp.nwic.gov.in/
#
# Note:
#   When government water portals experience SSL certificate expiration or downtime,
#   FloodGuard automatically loads the authoritative CWC 2018 Flood Atlas gauge station
#   atlas (Malakkara, Kallooppara, Thumpamon, Kidangoor) with Warning, Danger, and
#   2018 HFL thresholds, alongside calibrated GloFAS river discharge simulation.
CWC_API_URL=https://ffs.india-water.gov.in
NWIC_API_URL=https://nwdp.nwic.gov.in

# ------------------------------------------------------------------------------
# 4. NDMA SACHET — National Disaster Alert Portal (CAP Feed)
# ------------------------------------------------------------------------------
# Portal: https://sachet.ndma.gov.in/
# The SACHET Common Alerting Protocol (CAP) endpoint is publicly accessible and
# does not require API keys. Filtered automatically for Kerala / Alappuzha.
SACHET_BASE_URL=https://sachet.ndma.gov.in

# ------------------------------------------------------------------------------
# 5. Copernicus Data Space Ecosystem (CDSE) / Sentinel-1 SAR
# ------------------------------------------------------------------------------
# Documentation: https://documentation.dataspace.copernicus.eu/APIs/STAC.html
# Catalogue endpoint for discovering Sentinel-1 C-band SAR acquisitions over
# Alappuzha AOI [76.30, 9.30, 76.60, 9.60] and Relative Orbit 144.
#
# Catalogue search is public and does not require credentials.
# Username/Password are only required if raw multi-gigabyte GRD files are to be
# downloaded automatically via the CDSE OData API.
COPERNICUS_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
