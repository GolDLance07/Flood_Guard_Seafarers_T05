# ==============================================================================
# FloodGuard Frontend Environment Variables (.env)
# ==============================================================================
# Place a copy of this file at: frontend/.env
#
# Vite reads variables prefixed with VITE_ at build / dev time.
# ==============================================================================

# Backend API Base URL
# - In development (when running `npm run dev` on port 5173 and FastAPI on 8000):
#   Set to http://localhost:8000
# - In production / containerized deployment (when FastAPI directly serves the
#   built static files at /app and /):
#   Can be left empty ('') to use relative path calls.
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Supabase Frontend Authentication & Incident Storage
# ------------------------------------------------------------------------------
# Security Rule: Only the safe public anon/publishable key is permitted here.
# NEVER place service role or secret keys in VITE variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Note on Map Basemaps:
# FloodGuard uses OpenFreeMap (Liberty & Dark) and Esri World Imagery (Satellite).
# Neither requires an API key or token. CARTO API key dependencies have been
# completely removed.
